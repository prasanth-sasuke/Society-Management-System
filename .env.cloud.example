# Copy this file to .env.cloud (gitignored) and paste Neon connection strings.
# Never commit .env.cloud.
#
# Neon dashboard → Connect:
#   DATABASE_URL = pooled connection (host contains "-pooler")
#   DIRECT_URL   = direct connection (no "-pooler") — required for prisma migrate
# Append sslmode=require if the dashboard URL does not already include it.

NODE_ENV=production

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
