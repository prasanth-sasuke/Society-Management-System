# Copy this file to .env and replace CHANGE_ME with your local password.
# Never commit .env.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

PGHOST=localhost
PGPORT=5432
PGUSER=society_app
PGPASSWORD=CHANGE_ME
PGDATABASE=society_management_dev

# Prisma / Node clients. Locally DIRECT_URL matches DATABASE_URL.
# On Neon: DATABASE_URL is the pooled host (-pooler); DIRECT_URL is the unpooled host.
# Both Neon URLs must include sslmode=require. Never commit real cloud credentials.
DATABASE_URL=postgresql://society_app:CHANGE_ME@localhost:5432/society_management_dev
DIRECT_URL=postgresql://society_app:CHANGE_ME@localhost:5432/society_management_dev

# The Vite app proxies /api to PORT. Do not put this password in web/.env.

# Auth (Phase 6). Generate JWT_SECRET locally; never commit the real value.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=12h
# Only used by prisma seed. Put the real values in gitignored .env / .env.cloud.
SUPERADMIN_EMAIL=CHANGE_ME
SUPERADMIN_PASSWORD=CHANGE_ME

# Production (Render): set these in the host dashboard, not in git.
# DATABASE_URL / DIRECT_URL come from gitignored .env.cloud (Neon pooled + direct).
# JWT_SECRET is generated by Render. CORS is optional when the UI is served from the same origin.
# NODE_ENV=production
# PORT is set by the host.
