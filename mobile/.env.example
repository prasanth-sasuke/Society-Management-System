# Copy to mobile/.env to override. EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here.
# Default when unset: the live Render API.
EXPO_PUBLIC_API_URL=https://society-operations-suite.onrender.com

# To test against the API on this laptop instead (phone and laptop on the same Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.31.33:3001
