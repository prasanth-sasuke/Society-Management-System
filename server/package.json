    "backup:cloud": "node scripts/backup-cloud.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5",
